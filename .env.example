# ============================================================
# INTENT AI PLATFORM - Environment Variables Template
# Copy this file to '.env' and insert your personal API keys.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GITHUB / VERSION CONTROL.
# ============================================================

# Google Gemini API Key (used by the desktop app and as the website's backup AI)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Website-only primary AI provider. Never used by the desktop agent.
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Web API demo account (never reuse a real account password)
WEB_PUBLIC_DEMO=false
WEB_DEMO_USERNAME=judge
WEB_DEMO_PASSWORD=replace_with_a_long_unique_demo_password

# Use a cryptographically random value with at least 32 characters
WEB_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# MongoDB Configuration (optional local event logging)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=intent_platform
